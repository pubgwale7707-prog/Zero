<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card_premium"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/copy_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Copying OBB File..."
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/copy_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:indicatorColor="@color/premium_pink"
        app:trackColor="#33FFFFFF"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        android:progress="0"
        android:max="100" />

    <TextView
        android:id="@+id/copy_percentage_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="0%"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
